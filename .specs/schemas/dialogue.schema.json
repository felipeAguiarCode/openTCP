{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:card-campaign:schema:dialogue:1",
  "title": "Diálogo local",
  "type": "object",
  "properties": {
    "dialogueId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "speakerId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "mood": {
            "enum": [
              "NEUTRAL",
              "HAPPY",
              "SERIOUS",
              "SURPRISED"
            ]
          }
        },
        "required": [
          "speakerId",
          "text"
        ],
        "additionalProperties": false
      },
      "maxItems": 20,
      "minItems": 1
    }
  },
  "required": [
    "dialogueId",
    "lines"
  ],
  "additionalProperties": false
}
