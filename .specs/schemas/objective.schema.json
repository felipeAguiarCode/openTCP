{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:card-campaign:schema:objective:1",
  "title": "Objetivo de encontro",
  "type": "object",
  "properties": {
    "objectiveId": {
      "type": "string",
      "pattern": "^(P00-T0[1-6]|C0[1-6]-E0[1-6]|F00-D0[1-3])-(WIN|TACTIC|DECK|PUZZLE|TUTORIAL)$"
    },
    "scope": {
      "const": "SINGLE_ATTEMPT"
    },
    "requiresVictory": {
      "type": "boolean"
    },
    "predicates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "WIN",
              "DECK_COMPOSITION",
              "PLACED_ON_BENCH_AT_LEAST",
              "EVOLVED_AT_LEAST",
              "MANUAL_ENERGY_ATTACHED_AT_LEAST",
              "PLAYED_SUBTYPES",
              "RETREATED_AT_LEAST",
              "SWITCH_EFFECT_USED",
              "DISTINCT_ATTACKERS_AT_LEAST",
              "DISTINCT_ATTACK_DAMAGE_SOURCES_AT_LEAST",
              "ENERGY_ON_ONE_POKEMON_AT_LEAST",
              "ACTIVATED_ABILITY_USED",
              "CONDITION_REMOVED_BY_CAUSE",
              "EVOLVED_POKEMON_WITH_CONDITION",
              "DELAYED_EFFECT_PREVENTED",
              "TOOL_ATTACHED",
              "STADIUM_REPLACED_DIFFERENT_NAME",
              "MODIFIER_SOURCE_REMOVED",
              "KNOCKOUT_WITHOUT_ATTACK",
              "KNOCKED_OUT_ROLE",
              "KNOCKED_OUT_RULEBOX",
              "OWN_TURNS_AT_MOST",
              "OPPONENT_POINTS_AT_MOST",
              "WIN_IN_PREPARED_TURN"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "controller": {
            "enum": [
              "HUMAN"
            ]
          },
          "minimumDamage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9990
          },
          "subtypes": {
            "type": "array",
            "items": {
              "enum": [
                "ITEM",
                "SUPPORTER",
                "TOOL",
                "STADIUM"
              ]
            },
            "maxItems": 4,
            "minItems": 1,
            "uniqueItems": true
          },
          "causes": {
            "type": "array",
            "items": {
              "enum": [
                "SWITCH",
                "RETREAT",
                "EVOLUTION",
                "EFFECT"
              ]
            },
            "maxItems": 4,
            "minItems": 1,
            "uniqueItems": true
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "ruleBoxes": {
            "type": "array",
            "items": {
              "enum": [
                "EX",
                "MEGA_EX"
              ]
            },
            "maxItems": 2,
            "minItems": 1,
            "uniqueItems": true
          },
          "composition": {
            "type": "object",
            "properties": {
              "minBasic": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              },
              "maxRuleBoxCopies": {
                "type": "object",
                "properties": {
                  "EX": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "MEGA_EX": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              "minRuleBoxCopies": {
                "type": "object",
                "properties": {
                  "EX": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "MEGA_EX": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              "exactEnergyTypeCount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "minSubtypeCopies": {
                "type": "object",
                "properties": {
                  "TOOL": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "STADIUM": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "ITEM": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "SUPPORTER": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              "minCardsWithOpcode": {
                "type": "object",
                "properties": {
                  "opcodes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Z_]+(:[A-Z_]+)?$"
                    },
                    "maxItems": 10,
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  }
                },
                "required": [
                  "opcodes",
                  "count"
                ],
                "additionalProperties": false
              },
              "minDistinctEvolutionLines": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "maxStarterPrintings": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              },
              "minSetCards": {
                "type": "object",
                "properties": {
                  "setIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
                    },
                    "maxItems": 7,
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  }
                },
                "required": [
                  "setIds",
                  "count"
                ],
                "additionalProperties": false
              },
              "minTypeCards": {
                "type": "object",
                "properties": {
                  "types": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "GRASS",
                        "FIRE",
                        "WATER",
                        "LIGHTNING",
                        "PSYCHIC",
                        "FIGHTING",
                        "DARKNESS",
                        "METAL",
                        "DRAGON",
                        "COLORLESS"
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 10,
                    "uniqueItems": true
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  }
                },
                "required": [
                  "types",
                  "count"
                ],
                "additionalProperties": false
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      },
      "maxItems": 4,
      "minItems": 1
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "reward": {
      "type": "object",
      "properties": {
        "credits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "credits"
      ],
      "additionalProperties": false
    },
    "claimPolicy": {
      "const": "AUTOMATIC_ON_RESULT"
    },
    "grantKey": {
      "type": "string",
      "pattern": "^objective:[a-z0-9-]+:[A-Z0-9-]+$"
    }
  },
  "required": [
    "objectiveId",
    "scope",
    "requiresVictory",
    "predicates",
    "description",
    "reward",
    "claimPolicy",
    "grantKey"
  ],
  "additionalProperties": false
}
