{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:card-campaign:schema:campaign-node:1",
  "title": "Nó da campanha",
  "type": "object",
  "properties": {
    "nodeId": {
      "type": "string",
      "pattern": "^(P00-T0[1-6]|C0[1-6]-E0[1-6]|F00-D0[1-3])$"
    },
    "campaignId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "chapterId": {
      "enum": [
        "P00",
        "C01",
        "C02",
        "C03",
        "C04",
        "C05",
        "C06",
        "F00"
      ]
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "kind": {
      "enum": [
        "TUTORIAL",
        "DUEL",
        "PUZZLE",
        "DISCOVERY",
        "ELITE",
        "BOSS",
        "FINAL"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "essential": {
      "type": "boolean"
    },
    "prerequisites": {
      "type": "object",
      "properties": {
        "allOf": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(P00-T0[1-6]|C0[1-6]-E0[1-6]|F00-D0[1-3])$"
          },
          "maxItems": 6,
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "allOf"
      ],
      "additionalProperties": false
    },
    "npcId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "arenaId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "mapSceneId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "difficultyProfiles": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "STORY": {
              "type": "object",
              "properties": {
                "aiProfileId": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
                },
                "npcDeckId": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
                }
              },
              "required": [
                "aiProfileId",
                "npcDeckId"
              ],
              "additionalProperties": false
            },
            "STANDARD": {
              "type": "object",
              "properties": {
                "aiProfileId": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
                },
                "npcDeckId": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
                }
              },
              "required": [
                "aiProfileId",
                "npcDeckId"
              ],
              "additionalProperties": false
            },
            "EXPERT": {
              "type": "object",
              "properties": {
                "aiProfileId": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
                },
                "npcDeckId": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
                }
              },
              "required": [
                "aiProfileId",
                "npcDeckId"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "STORY",
            "STANDARD",
            "EXPERT"
          ],
          "additionalProperties": false
        }
      ]
    },
    "fixtureId": {
      "type": [
        "string",
        "null"
      ]
    },
    "turnLimit": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "ownTurns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          },
          "required": [
            "ownTurns"
          ],
          "additionalProperties": false
        }
      ]
    },
    "completionObjectiveId": {
      "type": [
        "string",
        "null"
      ]
    },
    "optionalObjectiveIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 0,
      "uniqueItems": true
    },
    "firstClearRewardTableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "repeatRewardTableId": {
      "type": [
        "string",
        "null"
      ]
    },
    "keyCardReward": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "FIXED",
                "CHOICE"
              ]
            },
            "printingIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
              },
              "maxItems": 3,
              "minItems": 1,
              "uniqueItems": true
            },
            "copies": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            }
          },
          "required": [
            "mode",
            "printingIds",
            "copies"
          ],
          "additionalProperties": false
        }
      ]
    },
    "discoveryOffer": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "maxItems": 3,
          "minItems": 3,
          "uniqueItems": true
        }
      ]
    },
    "supportDeckIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
      },
      "maxItems": 3,
      "minItems": 0,
      "uniqueItems": true
    },
    "roleTags": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "maxItems": 4,
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "dialogue": {
      "type": "object",
      "properties": {
        "briefing": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
        },
        "intro": {
          "type": [
            "string",
            "null"
          ]
        },
        "victory": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
        },
        "defeat": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
        }
      },
      "required": [
        "briefing",
        "victory",
        "defeat"
      ],
      "additionalProperties": false
    },
    "map": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "icon": {
          "enum": [
            "BATTLE",
            "PUZZLE",
            "DISCOVERY",
            "ELITE",
            "BOSS",
            "TUTORIAL",
            "FINAL"
          ]
        }
      },
      "required": [
        "x",
        "z",
        "icon"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "nodeId",
    "campaignId",
    "chapterId",
    "contentVersion",
    "kind",
    "title",
    "essential",
    "prerequisites",
    "npcId",
    "arenaId",
    "mapSceneId",
    "difficultyProfiles",
    "fixtureId",
    "turnLimit",
    "completionObjectiveId",
    "optionalObjectiveIds",
    "firstClearRewardTableId",
    "repeatRewardTableId",
    "keyCardReward",
    "discoveryOffer",
    "supportDeckIds",
    "dialogue",
    "map"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "DISCOVERY"
          }
        }
      },
      "then": {
        "properties": {
          "discoveryOffer": {
            "type": "array"
          },
          "difficultyProfiles": {
            "type": "null"
          },
          "completionObjectiveId": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "DUEL",
              "ELITE",
              "BOSS",
              "FINAL"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "difficultyProfiles": {
            "type": "object"
          },
          "discoveryOffer": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "TUTORIAL",
              "PUZZLE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "fixtureId": {
            "type": "string"
          }
        }
      }
    }
  ]
}
